
#include <stdio.h>

#define MAX 10

void readMatrix(int a[MAX][MAX], int r, int c)
{
    int i, j;

    for (i = 0; i < r; i++)
        for (j = 0; j < c; j++)
            scanf("%d", &a[i][j]);
}

void displayMatrix(int a[MAX][MAX], int r, int c)
{
    int i, j;

    for (i = 0; i < r; i++)
    {
        for (j = 0; j < c; j++)
            printf("%d ", a[i][j]);

        printf("\n");
    }
}

void addMatrix(int a[MAX][MAX], int b[MAX][MAX],
               int r, int c)
{
    int result[MAX][MAX];
    int i, j;

    for (i = 0; i < r; i++)
        for (j = 0; j < c; j++)
            result[i][j] = a[i][j] + b[i][j];

    printf("Addition:\n");
    displayMatrix(result, r, c);
}

void multiplyMatrix(int a[MAX][MAX], int b[MAX][MAX],
                    int r1, int c1, int c2)
{
    int result[MAX][MAX] = {0};
    int i, j, k;

    for (i = 0; i < r1; i++)
    {
        for (j = 0; j < c2; j++)
        {
            for (k = 0; k < c1; k++)
            {
                result[i][j] += a[i][k] * b[k][j];
            }
        }
    }

    printf("Multiplication:\n");
    displayMatrix(result, r1, c2);
}

void transposeMatrix(int a[MAX][MAX], int r, int c)
{
    int result[MAX][MAX];
    int i, j;

    for (i = 0; i < r; i++)
        for (j = 0; j < c; j++)
            result[j][i] = a[i][j];

    printf("Transpose:\n");
    displayMatrix(result, c, r);
}

int main()
{
    int a[MAX][MAX], b[MAX][MAX];
    int r1, c1, r2, c2;

    printf("Enter rows and columns of Matrix A: ");
    scanf("%d %d", &r1, &c1);

    printf("Enter elements of Matrix A:\n");
    readMatrix(a, r1, c1);

    printf("Enter rows and columns of Matrix B: ");
    scanf("%d %d", &r2, &c2);

    printf("Enter elements of Matrix B:\n");
    readMatrix(b, r2, c2);

    if (r1 == r2 && c1 == c2)
        addMatrix(a, b, r1, c1);
    else
        printf("Addition is not possible.\n");

    if (c1 == r2)
        multiplyMatrix(a, b, r1, c1, c2);
    else
        printf("Multiplication is not possible.\n");

    transposeMatrix(a, r1, c1);

    return 0;
}
